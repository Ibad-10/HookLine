# Copy to .env and fill in. Never commit .env.

# Mubit gateway: every LLM call goes through here.
# Provider keys (Anthropic, OpenAI, Groq) are added in the Mubit console under
# Provider keys, not here. The app only sends the Mubit key.
MUBIT_API_KEY=
MUBIT_OPENAI_BASE_URL=https://api.mubit.ai/openai/v1
MUBIT_ANTHROPIC_BASE_URL=https://api.mubit.ai/anthropic
MUBIT_GROQ_BASE_URL=https://api.mubit.ai/compat/groq/v1

# Which frontier model the Teacher and Coach start on (Mubit learns from these).
TEACHER_MODEL=
COACH_MODEL=

# ElevenLabs voice for practice calls.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Turso database for production. Leave empty locally to use the hookline.db file.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Key for the "Run the comparison again" button on /mubit. Empty = button turned off.
ADMIN_KEY=

# Clerk (dashboard.clerk.com > Hookline > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home
# Admin console access (comma-separated emails)
ADMIN_EMAILS=

# Real practice (design doc section 16)
PUBLIC_URL=https://hookline-one-iota.vercel.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
TWILIO_VERIFY_SID=
AGENT_SECRET=
ELEVENLABS_AGENT_ID=
